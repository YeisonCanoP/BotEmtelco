APP_ENV=development
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/retail_ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=5000
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
AGENT_MAX_TOOL_ROUNDS=5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_SCORE_THRESHOLD=0.30
KNOWLEDGE_SCORE_MARGIN=0.10
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_SESSION_PREFIX=retail-ai:session
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_FILENAME=app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
